# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=4100

# Persistence
MONGODB_URI=mongodb://127.0.0.1:27017/orbik

# Browser access: comma-separated exact origins, never wildcard patterns. The first is the web app's
# own address, which invite links, the OAuth consent screen and MCP Library links are built from.
# In production, the web app's public address, e.g. https://orbik.example.com.
FRONTEND_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# Generate a unique high-entropy value in the untracked backend/.env file.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_SECONDS=86400

# With true, SESSION_SECRET and ORBIK_ASSET_URL_SECRET may be left unset: each is generated on the
# first start and kept in the database (system_state). The Docker install sets it.
# ORBIK_GENERATE_SECRETS=false

# ---------------------------------------------------------------------------------------------
# Accounts. An install with no account prints a one-time setup code at start; the web app's
# /setup page takes it and creates the first account. After that, people join by invite —
# or, with ORBIK_SIGNUP=open, sign themselves up at /signup. While it is closed, /signup asks for
# access, and the install's admins approve or dismiss each request on the Admin page (/admin).
# ORBIK_SIGNUP=closed
#
# The install's admins, comma-separated. Unset: the install's first account.
# ORBIK_ADMIN_EMAILS=
#
# Email, optional: with it, invites, approved access requests and password reset links are
# emailed as well as shown; without it, the admin makes a reset link for whoever forgot theirs. smtp://user:pass@host:587 or
# smtps://user:pass@host:465, and the address mail is sent from.
# SMTP_URL=
# EMAIL_FROM=Orbik <orbik@example.com>

# ---------------------------------------------------------------------------------------------
# Listening behind a proxy. HOST must be loopback unless ALLOW_NON_LOOPBACK_HOST=true, which is for
# a container on a network the proxy reaches it over. TRUST_PROXY says which hops may report the
# client's address (X-Forwarded-For), in Express's terms: loopback (default) for a proxy on the
# same machine, loopback,uniquelocal for one on a container network.
# ALLOW_NON_LOOPBACK_HOST=false
# TRUST_PROXY=loopback

# ---------------------------------------------------------------------------------------------
# Extensions: modules that add plans, routes and the like without changing this repository,
# comma separated, by package name or path (docs/architecture/extensions.md). Set the same list in agents/.env.
# Unset, nothing is limited.
# ORBIK_EXTENSIONS=

# ---------------------------------------------------------------------------------------------
# The retrieval index, read by the MCP server's `content_search` and by nothing else in this
# process. These must match the agents worker's settings: the worker fills the index, the API only
# searches it. All optional — an API without the embedding key serves every other MCP tool and
# reports INDEX_UNAVAILABLE with the reason, rather than refusing to start.
#
# EMBEDDINGS ONLY, exactly as in agents/.env.example: this key pays for turning text into vectors
# and for nothing else. It is never written to a run or echoed into an
# error, and the one module that reaches a non-Claude model with it is
# packages/retrieval/src/embeddings.js.
# ORBIK_OPENAI_API_KEY=sk-proj-...
# ORBIK_EMBEDDING_MODEL=text-embedding-3-small
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=orbik_chunks
# QDRANT_API_KEY=

# ---------------------------------------------------------------------------------------------
# The MCP endpoint at POST /mcp, which a person's own AI client reads their workspaces through, and
# writes to their Libraries through when they allowed it.
#
# Requests a minute one MCP credential may make. 1-10000, default 120.
# MCP_REQUESTS_PER_MINUTE=120
#
# Library writes a minute one credential that may write can make (library_write, library_mkdir),
# counted apart from the requests above. A write past it is refused as WRITE_RATE_LIMITED.
# 1-1000, default 20.
# MCP_WRITES_PER_MINUTE=20
#
# A credential that may write sends whole Library files, so /mcp accepts a body of up to 1 MB from
# one (32 kb from a read-only one). Behind nginx, `location = /mcp` needs `client_max_body_size 1m`.
#
# This API's own public origin. Required in any deployment behind a proxy: it is the OAuth `issuer`
# and the `resource` an MCP client compares character for character, and a client handed an issuer
# that differs from the one it discovered refuses the server rather than degrading. Defaults to
# http://HOST:PORT, which is correct only in development.
# PUBLIC_API_URL=https://api.orbik.example.com

# ---------------------------------------------------------------------------------------------
# Signed links to a workspace's brand assets: its logos, images and screenshots.
#
# A person's own AI reads the design system over MCP, and an image is handed to it as a link that
# carries its own permission and stops working after an hour. This is the secret those links are
# signed with. Optional: without it every other tool still answers, the tools that would carry a
# link say that links are not configured, and an image can still be read inline. Rotating it
# invalidates every link already handed out.
#
# Generate one with: openssl rand -base64 48
# ORBIK_ASSET_URL_SECRET=replace-with-at-least-32-random-characters

# ---------------------------------------------------------------------------------------------
# devbar (npm `@codalent/devbar`), a development machine's toolbar for tasks, bugs and ideas, kept as
# Markdown in the repository's .devbar/. With it on, the API serves it at /v1/devbar/ to requests
# that carry ORBIK_DEVBAR_KEY, a shared secret; nobody signs in to it. Open the web app once as
# <app>/?devbar=<key> in each browser that should show it. Leave it off on a deployment.
# ORBIK_DEVBAR=true
# ORBIK_DEVBAR_KEY=   # required when on: openssl rand -hex 24
