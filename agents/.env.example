# Runtime. Agent processes bind no port: the API on 4100 is the only HTTP listener.
NODE_ENV=development

# Persistence. Must be the same database the API uses; the agents read workspaces and write
# their own collections.
MONGODB_URI=mongodb://127.0.0.1:27017/orbik

# Identity recorded as the owner of a claimed job, and of the crawl lease. Defaults to
# <hostname>-<pid>, which is already unique per process; set it explicitly only to make logs
# easier to correlate, and never to the same value for two processes that run at once: the
# crawl lease is one worker's, and two workers under one name would both crawl the same site.
# AGENT_WORKER_ID=worker-1

# Jobs executed at once by this worker, crawl jobs included: one worker at a time crawls, and it
# reads up to this many pages of the run together. That makes it the cap on requests in flight
# to a site, not on how often they are sent: a host is asked at most four times a second however
# many pages are being read (docs/architecture/crawler.md, "Pace"). 1-64, default 4.
# AGENT_CONCURRENCY=4

# Poll interval in milliseconds: the longest the worker waits before looking at the queue again
# when it had nothing to claim. A job of its own finishing ends the wait at once, and so does a
# delayed job coming due, so this is not a pause between jobs. 100-60000, default 1000.
# AGENT_POLL_INTERVAL_MS=1000

# How long a claimed job stays owned without a heartbeat. Lower recovers faster from a crashed
# worker; higher tolerates longer pauses. 30-3600, default 300.
# AGENT_LEASE_SECONDS=300

# Attempts before a job is dead-lettered with its final error. 1-20, default 5.
# AGENT_MAX_ATTEMPTS=5

# How long a shutdown waits for in-flight jobs before releasing them back to the queue.
# 1000-120000, default 20000.
# AGENT_SHUTDOWN_GRACE_MS=20000

# How often the scheduler looks for a site or an agent schedule that has become due.
# 1000-3600000, default 60000.
# AGENT_SCHEDULER_INTERVAL_MS=60000

# How often the dispatcher looks for an accepted run to put on the job queue.
# Lower is more responsive to someone pressing Run; this is a cheap indexed query.
# 250-60000, default 2000.
# AGENT_DISPATCHER_INTERVAL_MS=2000

# ---------------------------------------------------------------------------------------------
# The reasoning provider. The route table (DEFAULT_ROUTES in src/ai/model/modelRouter.js) sends
# every reasoning call to Anthropic with this key: agent runs, the Library chat and the short texts
# plain-code agents ask for. The embeddings stay on ORBIK_OPENAI_API_KEY, below.
#
# Optional. A worker without it still starts and crawls; it reports "no AI provider is
# configured" on the first run that needs a model, and the Library's knowledge base is not written.
#
# Never logged and never echoed into an error.
# ORBIK_ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------------------------
# The retrieval index: the vector database beside MongoDB.
#
# Qdrant runs as a local process, like MongoDB, and holds one collection per environment with
# every point carrying its workspace in the payload. Nothing here is required: a worker without
# an embedding key crawls, audits and writes Libraries exactly as before, indexes nothing, and
# says so on the Library and ask pages.
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=orbik_chunks
# QDRANT_API_KEY=

# ---------------------------------------------------------------------------------------------
# Orbik's own OpenAI credential: the embeddings behind the retrieval index, the one model call
# that is not Claude. It would also serve the reasoning calls if the route table were pointed back
# at OpenAI (OPENAI_ROUTES in src/ai/model/modelRouter.js). Users never supply one.
#
# Optional. A worker without it still starts and crawls; it indexes nothing — so a crawler-only
# deployment needs nothing here.
#
# Embeddings go through packages/retrieval/src/embeddings.js. The key is never written to a run
# and never echoed into an error.
#
# Two processes read it: this worker, which fills the index, and the API, which searches it for
# MCP clients (backend/.env, same variable). Set the same value, the same QDRANT_URL, the same
# QDRANT_COLLECTION and the same ORBIK_EMBEDDING_MODEL in both, or one will search an index the
# other did not write.
#
# Without it, indexing is skipped with a recorded reason and search says the index is not
# configured. At $0.02 per million tokens a 72-page site costs well under a cent to index, and
# re-indexing only touches pages whose words actually changed.
# ORBIK_OPENAI_API_KEY=sk-proj-...
# ORBIK_EMBEDDING_MODEL=text-embedding-3-small

# How often the index scheduler looks for a workspace whose pages or Library files have been
# written since they were last embedded. 5000-3600000, default 60000.
# AGENT_INDEX_INTERVAL_MS=60000

# ---------------------------------------------------------------------------------------------
# The source layer: a copy of every crawled page in the Library, written by the `sources.mirror`
# job. It calls no model and needs no key, so a worker with no provider still mirrors every site.
#
# How often the Library scheduler looks for a workspace whose pages have been rendered since they
# were last copied, whose copy failed, or where somebody has asked for a page by name — and
# decides whether the knowledge base should be rewritten. 5000-3600000, default 60000.
# AGENT_SOURCE_INTERVAL_MS=60000

# ---------------------------------------------------------------------------------------------
# Extensions: the same list as backend/.env (docs/architecture/extensions.md). Unset, nothing is limited.
# ORBIK_EXTENSIONS=

# ---------------------------------------------------------------------------------------------
# Crawler contact page: the address the crawler's User-Agent names, so a site owner who sees
# OrbikBot in their logs can find whoever runs this install. Default:
# https://orbik.io/docs/orbikbot (docs/orbikbot.md).
# ORBIK_CRAWLER_CONTACT_URL=https://example.com/orbikbot

# ---------------------------------------------------------------------------------------------
# Anonymous usage statistics, off by default. on: once a day the scheduler sends counts of
# workspaces, pages fetched and agent runs, and which optional services are configured — never
# content, addresses, emails or keys (docs/self-hosting/usage-statistics.md lists every field).
# ORBIK_TELEMETRY=off
# ORBIK_TELEMETRY_URL=https://telemetry.orbik.io/v1/ping
