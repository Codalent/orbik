# Settings for `docker compose up` (compose.yaml). Copy to `.env` beside it; every line is optional.
# This file is only for the Docker install: the bare-metal processes read backend/.env and
# agents/.env instead.

# --- Where the install is reached ------------------------------------------------------------
# The address people and AI clients use. Must match what is in their browser's address bar.
# ORBIK_URL=http://localhost:8080
#
# Ports published on this machine, on loopback only by default. For a public server with a
# domain, open them with ORBIK_BIND_ADDRESS=0.0.0.0, use 80 and 443, and set ORBIK_SITE_ADDRESS to
# the domain: the proxy then gets an HTTPS certificate for it on its own.
# ORBIK_BIND_ADDRESS=127.0.0.1
# ORBIK_HTTP_PORT=8080
# ORBIK_HTTPS_PORT=8443
# ORBIK_SITE_ADDRESS=orbik.example.com
# (and then ORBIK_URL=https://orbik.example.com, ORBIK_BIND_ADDRESS=0.0.0.0, ORBIK_HTTP_PORT=80,
# ORBIK_HTTPS_PORT=443)
#
# Behind another proxy that handles HTTPS (nginx already on 80 and 443 of this server, a load
# balancer): keep the defaults above, set ORBIK_URL to the https:// address, and trust that proxy,
# or nobody can stay signed in. private_ranges covers nginx on the same server; otherwise name the
# proxy's addresses. See docs/self-hosting/https.md, "Behind another proxy".
# ORBIK_TRUSTED_PROXIES=private_ranges

# --- AI: your own keys -------------------------------------------------------------------------
# Required for search: the embeddings behind the retrieval index, Ask and content_search. With only
# this key set, it also makes every reasoning call (agent runs, the Library's knowledge base, Ask).
# ORBIK_OPENAI_API_KEY=sk-proj-...
# Optional: with it set, the reasoning calls are made with Claude instead.
# ORBIK_ANTHROPIC_API_KEY=sk-ant-...
# Which provider makes the reasoning calls when both keys are set: anthropic or openai.
# Unset: Anthropic when its key is set, otherwise OpenAI.
# ORBIK_AI_PROVIDER=

# --- Accounts ----------------------------------------------------------------------------------
# closed (default): people join by invite. open: anyone who can reach the sign-in page can sign up.
# ORBIK_SIGNUP=closed
#
# The install's admins, comma-separated: they answer access requests and make password reset links
# on the Admin page. Unset: the install's first account.
# ORBIK_ADMIN_EMAILS=

# --- Email (optional) --------------------------------------------------------------------------
# With it, invites are also emailed. smtp://user:pass@host:587 or smtps://user:pass@host:465
# SMTP_URL=
# EMAIL_FROM=Orbik <orbik@example.com>

# --- Crawler ----------------------------------------------------------------------------------
# The page the crawler's User-Agent names, so a site owner who sees OrbikBot in their logs can find
# you. Default: https://orbik.io/docs/orbikbot (docs/orbikbot.md), which says the crawler is
# self-hosted.
# ORBIK_CRAWLER_CONTACT_URL=https://example.com/orbikbot

# --- Anonymous usage statistics ----------------------------------------------------------------
# Off by default. on: once a day the scheduler sends counts — no content, addresses, emails or
# keys. See docs/self-hosting/usage-statistics.md for exactly what.
# ORBIK_TELEMETRY=off
