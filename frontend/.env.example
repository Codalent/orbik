# Public browser API origin. This value is embedded at frontend build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4100

# Where the Orbik logo on the sign-in, signup and other signed-out pages links to.
# NEXT_PUBLIC_ORBIK_HOME_URL=https://orbik.io
# NEXT_PUBLIC_ORBIK_SOURCE_URL: the "Source code" link in the account menu. A changed copy run for
# other people points it at its own source (AGPL). Default: https://github.com/Codalent/orbik
# NEXT_PUBLIC_ORBIK_SOURCE_URL=
